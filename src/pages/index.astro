---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CatalogFilm from '../components/CatalogFilm.astro';
import { site, brands, categories } from '../data/site';

const all = await getCollection('products');
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const reasons = [
  {
    title: 'Asesoría técnica',
    text: 'La referencia correcta para tu presión, temperatura y fluido.',
  },
  {
    title: 'Marcas de confianza',
    text: 'Swagelok, Valveco, Comfit y Ferreinstrumentos. Producto original, con respaldo.',
  },
  {
    title: 'Respuesta rápida',
    text: 'Cotización por WhatsApp e inventario para no detener tu operación.',
  },
  {
    title: 'Cobertura nacional',
    text: 'Despacho a todo Colombia para plantas, contratistas y proyectos.',
  },
];
---

<Layout title={site.name}>
  <!--
    Precarga de la primera imagen del film (el elemento LCP del inicio). El
    imagesrcset/imagesizes deben coincidir exactamente con el <img> de
    CatalogFilm para que el navegador reutilice la precarga. Requiere que
    Layout.astro renderice <slot name="head" /> dentro de <head>.
  -->
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      imagesrcset="/videos/catalogo/stop-0.webp 1920w, /videos/catalogo/stop-0@2x.webp 3840w"
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>

  <!--
    Toda la página de inicio es un recorrido por la planta: el brand film queda
    fijo de fondo y cada sección es una parada. El contenido de cada parada se
    pasa por slots al componente; los titulares viven en CatalogFilm.astro.
    Las tarjetas entran escalonadas: el script del film les asigna data-reveal
    y --i por índice dentro de cada .grid.
  -->
  <CatalogFilm>
    <Fragment slot="stop-1">
      <p class="film-label">Líneas de producto</p>
      <div class="grid grid--3 lines-grid">
        {
          categories.map((c) => (
            <a class="cat-card card card--interactive glass--flat" href={`/productos?categoria=${c.slug}`}>
              <h3>{c.name}</h3>
              <p>{c.description}</p>
              <span class="link link--accent link-chevron"><span class="cat-card__cta">Ver productos</span></span>
            </a>
          ))
        }
      </div>
    </Fragment>

    <Fragment slot="stop-2">
      {
        featured.length > 0 && (
          <>
            <p class="film-label">Destacados</p>
            <!--
              Escritorio: una sola fila de 3 (las demás quedan ocultas por CSS).
              Móvil: carrusel con snap de las 6, para que la parada no apile
              seis tarjetas completas y el recorrido no pierda el ritmo.
            -->
            <div class="grid grid--3 featured-grid">
              {featured.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </>
        )
      }
    </Fragment>

    <Fragment slot="stop-3">
      <div class="grid grid--4">
        {
          reasons.map((r) => (
            <div class="reason card glass--flat">
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
          ))
        }
      </div>
    </Fragment>

    <Fragment slot="stop-4">
      <p class="film-label">Marcas que distribuimos</p>
      <ul class="brands-strip">
        {
          brands.map((b) => (
            <li>
              <a class="link link-chevron" href={`/productos?marca=${b.slug}`}>
                {b.name}
              </a>
            </li>
          ))
        }
      </ul>
    </Fragment>
  </CatalogFilm>
</Layout>

<style>
  /* Tarjetas de línea: cristal plano (sin segundo backdrop) dentro del panel. */
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }

  .cat-card:hover {
    border-color: rgb(242 118 27 / 0.55);
  }

  .cat-card h3,
  .reason h3 {
    margin: 0;
  }

  .cat-card p,
  .reason p {
    margin: 0;
    flex: 1;
    color: var(--color-text-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .cat-card .link {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  /* Razones: barra interna de acento (sin border-top sobre el radio, que dibujaba arcos). */
  .reason {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .reason::before {
    content: '';
    display: block;
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  /* Destacados en escritorio: una fila de tres. */
  .featured-grid > :global(:nth-child(n + 4)) {
    display: none;
  }

  /* Tira de marcas: en línea en escritorio, rejilla 2×2 en móvil. */
  .brands-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-7);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .brands-strip .link {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-2);
    padding: var(--space-1) 0;
  }

  .brands-strip .link:hover {
    color: var(--color-heading);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    /* Líneas como filas de 56 px con chevron: la descripción se lee en /productos. */
    .lines-grid {
      gap: var(--space-2);
    }

    .cat-card {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
      min-height: 56px;
      padding: var(--space-2) var(--space-4);
    }

    .cat-card h3 {
      flex: 1;
      font-size: var(--text-md);
      line-height: var(--leading-snug);
    }

    .cat-card p {
      display: none;
    }

    .cat-card .link {
      margin: 0;
    }

    .cat-card .link::after {
      width: 1em;
      height: 1em;
    }

    .cat-card__cta {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    /* Destacados: carrusel con snap, 78 % de ancho por tarjeta, a sangre del panel. */
    .featured-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: var(--space-3);
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-4);
      padding-bottom: var(--space-1);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
    }

    .featured-grid::-webkit-scrollbar {
      display: none;
    }

    .featured-grid > :global(*),
    .featured-grid > :global(:nth-child(n + 4)) {
      flex: 0 0 78%;
      scroll-snap-align: start;
      display: flex;
    }

    .featured-grid :global(.product-card__media) {
      aspect-ratio: 16 / 10;
    }

    .brands-strip {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2) var(--space-4);
    }

    .brands-strip .link {
      font-size: var(--text-lg);
    }
  }
</style>
