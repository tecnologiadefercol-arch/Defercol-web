---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import heroStill from '../assets/film/stop-4@2x.webp';
import { brands, whatsappLink } from '../data/site';

// Pendiente de contenido real: año de fundación, sectores atendidos y
// certificaciones. Mientras llegan, la página no muestra texto de plantilla.

const values = [
  {
    title: 'Confiabilidad',
    text: 'Producto original, con trazabilidad y respaldo del fabricante.',
  },
  {
    title: 'Conocimiento técnico',
    text: 'Entendemos tu proceso y recomendamos bien desde el inicio.',
  },
  {
    title: 'Cumplimiento',
    text: 'Entregas claras y comunicación en cada pedido.',
  },
];

const sectors = [
  'Petróleo, gas y petroquímica',
  'Alimentos y bebidas',
  'Farmacéutica y química',
  'Energía y servicios públicos',
  'Manufactura y metalmecánica',
];

// Hero: cuadro de una parada del brand film; astro:assets genera las anchuras
// intermedias para que un móvil no reciba el cuadro completo de 1920 px.
const hero = await getImage({
  src: heroStill,
  width: 1920,
  widths: [640, 960, 1280, 1920, 2560, 3840],
  sizes: '100vw',
  format: 'webp',
  quality: 70,
});

---

<Layout
  title="Quiénes somos"
  description="Defercol, distribuidor colombiano de racores, válvulas, tubería e instrumentación industrial: marcas, sectores y forma de trabajar."
>
  <section class="page-hero page-hero--image">
    <!-- Cuadro de una parada del brand film, en 1x y 2x para pantallas retina. -->
    <img
      class="page-hero__img"
      src={hero.src}
      srcset={hero.srcSet.attribute}
      sizes="100vw"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      style="object-position: 50% 45%"
    />
    <div class="container">
      <span class="eyebrow">Defercol</span>
      <h1>Distribuidor industrial con criterio técnico.</h1>
      <p>Conexión, control y medición de fluidos para plantas, contratistas e ingeniería en toda Colombia.</p>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <div class="about__text">
        <h2>Entender la aplicación. Entregar a tiempo.</h2>
        <p>
          Acompañamos a plantas, contratistas y empresas de ingeniería en la selección y el suministro
          de racores, válvulas, tubería, reguladores e instrumentación.
        </p>
        <p>
          Representamos marcas líderes y mantenemos inventario de las referencias de mayor rotación
          para mantenimiento, montaje y proyectos.
        </p>
      </div>
      <!-- Sin <aside>: la lista de sectores es parte de la sección, no contenido complementario de la página. -->
      <div class="about__aside">
        <div class="card sectors">
          <h3>Sectores</h3>
          <ul>
            {sectors.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>Así trabajamos.</h2>
      </div>
      <div class="grid grid--3">
        {
          values.map((v, i) => (
            <div class="card value">
              <span class="value__index" aria-hidden="true">0{i + 1}</span>
              <h3>{v.title}</h3>
              <p class="muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Marcas que distribuimos.</h2>
      </div>
      <div class="brands">
        {
          brands.map((b) => (
            <article class="card brand-card">
              <h3>{b.name}</h3>
              <p class="muted">{b.description}</p>
              <div class="brand-card__links">
                <a class="link link-chevron brand-card__link" href={`/productos?marca=${b.slug}`}>
                  Ver productos
                </a>
                {b.website && (
                  <a class="link brand-card__link" href={b.website} target="_blank" rel="noopener">
                    Sitio del fabricante<span class="ext" aria-hidden="true">↗</span>
                    <span class="visually-hidden">(se abre en otra pestaña)</span>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container cta">
      <h2>Hablemos de tu proyecto.</h2>
      <p class="lead">Cuéntanos qué necesitas y te asesoramos sin costo.</p>
      <a
        class="btn btn-whatsapp"
        href={whatsappLink('Hola Defercol, quiero asesoría para mi proyecto.')}
        target="_blank"
        rel="noopener"
      >
        Cotizar por WhatsApp
      </a>
    </div>
  </section>
</Layout>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-8, 48px);
    align-items: start;
  }

  /* Un escalón claro por debajo del h1 del hero (48 px): afirmación, no segundo título. */
  .about__text h2 {
    font-size: var(--text-2xl, 1.5rem);
    line-height: var(--leading-snug, 1.15);
    letter-spacing: var(--tracking-snug, -0.014em);
    margin-bottom: var(--space-4, 16px);
  }

  /* La primera línea del texto y el título "Sectores" de la tarjeta comparten línea base
     (24 px de relleno de la tarjeta menos la diferencia de cuerpos). */
  .about__text {
    padding-top: var(--about-text-offset, 20px);
  }

  .about__text p {
    max-width: 62ch;
    font-size: var(--text-lg, 1.05rem);
    line-height: var(--leading-normal, 1.5);
    text-wrap: pretty;
  }

  .about__text p:last-child {
    margin-bottom: 0;
  }

  .sectors h3 {
    font-size: var(--text-xl, 1.2rem);
    margin-bottom: var(--space-3, 12px);
  }

  .sectors ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }

  .sectors li {
    padding-block: var(--space-2, 8px);
    border-top: 1px solid var(--color-border);
  }

  .sectors li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .sectors li:last-child {
    padding-bottom: 0;
  }

  .value {
    display: grid;
    gap: var(--space-1, 4px);
  }

  .value__index {
    font-family: var(--font-mono, ui-monospace, Menlo, monospace);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xs, 0.75rem);
    font-weight: 600;
    letter-spacing: var(--tracking-caps, 0.1em);
    color: var(--color-accent-text, #b8520a);
    margin-bottom: var(--space-2, 8px);
  }

  .value h3 {
    font-size: var(--text-xl, 1.2rem);
    margin: 0;
  }

  .value p {
    margin: 0;
  }

  .brands {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5, 24px);
  }

  .brand-card {
    display: grid;
    align-content: start;
  }

  .brand-card h3 {
    font-size: var(--text-xl, 1.2rem);
    margin-bottom: var(--space-1, 4px);
  }

  .brand-card p {
    flex: 1;
    margin-bottom: var(--space-4, 16px);
  }

  .brand-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 8px) var(--space-4, 16px);
    margin-top: auto;
  }

  /* Área táctil de 32 px y texto 14 px para los enlaces de la tarjeta. */
  .brand-card__link {
    min-height: 32px;
    font-size: var(--text-sm, 0.9rem);
  }

  .ext {
    font-size: 0.85em;
    translate: 0 -1px;
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-bottom: var(--space-2, 8px);
  }

  .cta .lead {
    max-width: 48ch;
    margin: 0 auto var(--space-5, 24px);
    font-size: var(--text-lg, 1.05rem);
    color: var(--color-text-2, var(--color-muted));
  }

  @media (max-width: 1100px) {
    .brands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--space-6, 32px);
    }

    .about__text {
      padding-top: 0;
    }
  }

  @media (max-width: 600px) {
    .brands {
      grid-template-columns: 1fr;
    }
  }
</style>
