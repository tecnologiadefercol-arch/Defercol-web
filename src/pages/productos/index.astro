---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { brands, categories, whatsappLink } from '../../data/site';
import heroStill from '../../assets/film/stop-1@2x.webp';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'es'),
);

/**
 * Hero: cuadro de la parada "racores" del brand film. La copia en
 * src/assets/film (el original sigue en public/videos/catalogo) deja que
 * astro:assets genere las anchuras intermedias: un móvil recibe ~60 KB en
 * vez del cuadro completo de 1920 px.
 */
const hero = await getImage({
  src: heroStill,
  width: 1920,
  widths: [640, 960, 1280, 1920, 2560, 3840],
  sizes: '100vw',
  format: 'webp',
  quality: 70,
});

const countBy = (key: 'brand' | 'category', slug: string) => products.filter((p) => p.data[key] === slug).length;
const total = products.length;
---

<Layout
  title="Productos"
  description="Catálogo Defercol: racores, válvulas, tubería, reguladores e instrumentación Swagelok, Valveco, Comfit y Ferreinstrumentos. Filtra por marca y categoría y cotiza por WhatsApp."
>
  <!-- Precarga del hero (elemento LCP): mismo srcset/sizes que el <img> para que se reutilice. -->
  <Fragment slot="head">
    <link rel="preload" as="image" imagesrcset={hero.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
  </Fragment>

  <section class="page-hero page-hero--image catalog-hero">
    <img
      class="page-hero__img"
      src={hero.src}
      srcset={hero.srcSet.attribute}
      sizes="100vw"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
    <div class="container">
      <span class="eyebrow">Catálogo</span>
      <h1>Productos.</h1>
      <p>Busca por referencia, filtra por marca y cotiza por WhatsApp.</p>
    </div>
  </section>

  <section class="section catalog-section">
    <div id="catalog-sentinel" aria-hidden="true"></div>

    <!--
      Toda la barra es un <form method="get">: el script lee la URL al cargar
      (?categoria=…&marca=…&q=…) y la mantiene al filtrar. Sin JavaScript el
      sitio estático no puede filtrar, así que los controles se retiran y queda
      una nota con el enlace al catálogo PDF (ver <noscript> más abajo).
    -->
    <form
      id="filters"
      class="catalog-bar bar--sticky glass--thin"
      method="get"
      action="/productos"
      novalidate
      role="search"
      aria-label="Filtrar productos"
    >
      <div class="container catalog-bar__inner">
        <fieldset class="seg catalog-seg">
          <legend class="visually-hidden">Categoría</legend>
          <label class="seg__opt">
            <input type="radio" name="categoria" value="" checked />
            <span class="seg__btn">Todas</span>
          </label>
          {
            categories.map((c) => (
              <label class="seg__opt">
                <input type="radio" name="categoria" value={c.slug} />
                <span class="seg__btn">{c.shortName}</span>
              </label>
            ))
          }
        </fieldset>

        <div class="catalog-bar__row">
          <fieldset class="chips">
            <legend class="visually-hidden">Marca</legend>
            {
              brands.map((b) => (
                <label class="chip-opt">
                  <input type="checkbox" name="marca" value={b.slug} />
                  <span class="chip">{b.name}</span>
                </label>
              ))
            }
          </fieldset>

          <div class="search">
            <label for="q" class="visually-hidden">Buscar por referencia, marca o producto</label>
            <input
              type="search"
              id="q"
              name="q"
              class="input input--search"
              placeholder="Referencia o producto"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              maxlength="80"
              aria-describedby="q-hint"
            />
            <span id="q-hint" class="visually-hidden">Los resultados se actualizan al escribir.</span>
            <button type="button" class="search__clear" aria-label="Borrar búsqueda" hidden></button>
          </div>

          <!-- Solo móvil: abre la hoja de filtros. -->
          <button
            type="button"
            class="btn btn-ghost btn-sm filters-open"
            aria-haspopup="dialog"
            aria-controls="filters-sheet"
          >
            Filtros<span class="filters-open__count" hidden></span>
          </button>

        </div>
      </div>

      <noscript>
        <p class="container catalog-nojs">
          Los filtros y la búsqueda necesitan JavaScript.
          <a href="/catalogo" class="link link-chevron">Catálogo PDF</a>
        </p>
      </noscript>

      <!-- Chips activos (solo con filtros; en escritorio los sustituye "Quitar filtros" junto al contador). -->
      <div class="container catalog-applied" id="applied" hidden>
        <ul class="catalog-applied__list" aria-label="Filtros activos"></ul>
        <button type="reset" class="link-btn">Quitar filtros</button>
      </div>
    </form>

    <div class="container catalog__results">
      <div class="catalog__head" id="catalog-head">
        <div class="catalog__status">
          <p id="result-count" class="catalog__count" aria-live="polite" aria-atomic="true">
            {total} productos
          </p>
          <!-- Escritorio: el segmentado y las marcas ya muestran el estado; basta con poder quitarlo. -->
          <button type="reset" form="filters" id="clear-filters" class="link-btn catalog__clear" hidden>
            Quitar filtros
          </button>
        </div>
        <a href="/catalogo" class="link link-chevron catalog__pdf">Catálogo PDF</a>
      </div>

      <h2 class="visually-hidden">Resultados</h2>
      <ul id="product-grid" class="grid grid--3 catalog-grid is-in" role="list">
        {
          products.map((p, i) => (
            <li style={`--i: ${i}`}>
              <ProductCard product={p} index={i} />
            </li>
          ))
        }
      </ul>

      <div id="empty-state" class="empty" hidden>
        <h2>
          Sin resultados<span data-empty-for hidden> para <q data-empty-q></q></span>.
        </h2>
        <p class="muted">Prueba otra búsqueda o escríbenos: manejamos muchas más referencias de las que ves aquí.</p>
        <div class="empty__actions">
          <button type="button" class="btn btn-ghost" data-clear>Quitar filtros</button>
          <a
            class="btn btn-whatsapp"
            data-empty-wa
            href={whatsappLink('Hola Defercol, busco una referencia que no está en la web. ¿La manejan?')}
            target="_blank"
            rel="noopener"
          >
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hoja de filtros (solo móvil). Espejo de la barra: se sincroniza al abrir y al aplicar. -->
  <dialog id="filters-sheet" class="sheet" aria-labelledby="sheet-title">
    <form method="dialog" class="sheet__panel">
      <div class="sheet__handle" aria-hidden="true"></div>
      <header class="sheet__head">
        <h2 id="sheet-title">Filtros</h2>
        <button type="button" class="link-btn" data-sheet-reset>Quitar filtros</button>
      </header>
      <div class="sheet__body">
        <fieldset class="sheet__group">
          <legend>Categoría</legend>
          <label class="sheet__row">
            <input type="radio" name="categoria-m" value="" checked />
            <span>Todas</span>
            <span class="sheet__n mono">{total}</span>
          </label>
          {
            categories.map((c) => (
              <label class="sheet__row">
                <input type="radio" name="categoria-m" value={c.slug} />
                <span>{c.name}</span>
                <span class="sheet__n mono">{countBy('category', c.slug)}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset class="sheet__group">
          <legend>Marca</legend>
          {
            brands.map((b) => (
              <label class="sheet__row">
                <input type="checkbox" name="marca-m" value={b.slug} />
                <span>{b.name}</span>
                <span class="sheet__n mono">{countBy('brand', b.slug)}</span>
              </label>
            ))
          }
        </fieldset>
      </div>
      <footer class="sheet__foot">
        <button type="submit" value="apply" class="btn btn-primary" data-sheet-apply>Ver {total} productos</button>
      </footer>
    </form>
  </dialog>
</Layout>

<script>
  import { brands, categories, whatsappLink } from '../../data/site';

  type State = { categoria: string; marca: string[]; q: string };

  const norm = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/\s+/g, ' ')
      .trim();

  const brandName = (s: string) => brands.find((b) => b.slug === s)?.name ?? s;
  const catName = (s: string) => categories.find((c) => c.slug === s)?.name ?? s;
  const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Observadores de la visita actual; se desconectan antes de cada navegación.
  let observers: IntersectionObserver[] = [];

  function initCatalog() {
    const form = document.getElementById('filters') as HTMLFormElement | null;
    if (!form || form.dataset.ready) return; // idempotente (View Transitions)
    form.dataset.ready = '1';

    const grid = document.getElementById('product-grid')!;
    const items = Array.from(grid.querySelectorAll<HTMLLIElement>(':scope > li'));
    const cards = items.map((li) => li.firstElementChild as HTMLElement);
    const total = items.length;
    const count = document.getElementById('result-count')!;
    const head = document.getElementById('catalog-head')!;
    const empty = document.getElementById('empty-state')!;
    const applied = document.getElementById('applied')!;
    const appliedList = applied.querySelector('ul')!;
    const q = form.elements.namedItem('q') as HTMLInputElement;
    const clearQ = form.querySelector<HTMLButtonElement>('.search__clear')!;
    const openBtn = form.querySelector<HTMLButtonElement>('.filters-open')!;
    const openCount = openBtn.querySelector<HTMLElement>('.filters-open__count')!;
    const clearAll = document.getElementById('clear-filters') as HTMLButtonElement;
    const sentinel = document.getElementById('catalog-sentinel')!;
    const sheet = document.getElementById('filters-sheet') as HTMLDialogElement | null;

    const read = (): State => {
      const d = new FormData(form);
      return {
        categoria: String(d.get('categoria') ?? ''),
        marca: d.getAll('marca').map(String),
        q: String(d.get('q') ?? '').slice(0, 80),
      };
    };

    const matches = (card: HTMLElement, s: State, terms: string[]) =>
      (!s.categoria || card.dataset.category === s.categoria) &&
      (s.marca.length === 0 || s.marca.includes(card.dataset.brand ?? '')) &&
      terms.every((t) => (card.dataset.search ?? '').includes(t));

    const countFor = (s: State) => {
      const terms = norm(s.q).split(' ').filter(Boolean);
      return cards.reduce((n, c) => n + (matches(c, s, terms) ? 1 : 0), 0);
    };

    // 1) Filtrado: síncrono e inmediato.
    const filter = (s: State) => {
      const terms = norm(s.q).split(' ').filter(Boolean);
      let visible = 0;
      items.forEach((li, i) => {
        const ok = matches(cards[i], s, terms);
        li.hidden = !ok;
        if (ok) li.style.setProperty('--i', String(visible++));
      });
      renderApplied(s);
      empty.hidden = true; // se muestra al terminar el debounce (sin parpadeo a mitad de palabra)
      clearQ.hidden = s.q === '';
      const n = s.marca.length + (s.categoria ? 1 : 0);
      openCount.hidden = n === 0;
      openCount.textContent = String(n);
      clearAll.hidden = !(s.categoria || s.marca.length || s.q.trim());
      return visible;
    };

    // 2) Anuncio, estado vacío y URL: con debounce (Safari limita replaceState a 100/30 s).
    let timer = 0;
    const commit = (visible: number, s: State, delay: number) => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const filtered = !!(s.categoria || s.marca.length || s.q.trim());
        count.textContent =
          visible === 0 ? 'Sin resultados' : filtered ? `${visible} de ${total} productos` : `${visible} productos`;
        empty.hidden = visible > 0;
        if (visible === 0) renderEmpty(s);

        const p = new URLSearchParams();
        if (s.categoria) p.set('categoria', s.categoria);
        s.marca.forEach((m) => p.append('marca', m));
        if (s.q.trim()) p.set('q', s.q.trim());
        const qs = p.toString();
        const next = qs ? `${location.pathname}?${qs}` : location.pathname;
        if (next !== location.pathname + location.search) history.replaceState(history.state, '', next);
      }, delay);
    };

    /** Un solo paso: filtra ya y confirma tras el debounce (250 ms al teclear, 60 ms al pulsar). */
    const apply = (delay = 60) => {
      const s = read();
      commit(filter(s), s, delay);
    };

    const renderApplied = (s: State) => {
      const chips: { label: string; undo: () => void }[] = [];
      if (s.categoria)
        chips.push({
          label: catName(s.categoria),
          undo: () => {
            (form.querySelector('[name="categoria"][value=""]') as HTMLInputElement).checked = true;
          },
        });
      s.marca.forEach((m) =>
        chips.push({
          label: brandName(m),
          undo: () => {
            const box = form.querySelector<HTMLInputElement>(`[name="marca"][value="${CSS.escape(m)}"]`);
            if (box) box.checked = false;
          },
        }),
      );
      if (s.q.trim()) chips.push({ label: `“${s.q.trim()}”`, undo: () => (q.value = '') });

      applied.hidden = chips.length === 0;
      appliedList.replaceChildren(
        ...chips.map(({ label, undo }, i) => {
          const li = document.createElement('li');
          li.className = 'chip chip--active';
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chip__remove';
          b.setAttribute('aria-label', `Quitar filtro: ${label}`);
          b.addEventListener('click', () => {
            undo();
            apply();
            // El foco queda en un control visible: el siguiente chip o la búsqueda.
            const rest = appliedList.querySelectorAll<HTMLButtonElement>('.chip__remove');
            (rest[Math.min(i, rest.length - 1)] ?? q).focus();
          });
          li.append(document.createTextNode(label), b);
          return li;
        }),
      );
    };

    const renderEmpty = (s: State) => {
      const forEl = empty.querySelector<HTMLElement>('[data-empty-for]')!;
      const qEl = empty.querySelector<HTMLElement>('[data-empty-q]')!;
      const what = s.q.trim();
      forEl.hidden = !what;
      qEl.textContent = what;
      const parts = [`Hola Defercol, busco: ${what || 'un producto'}`];
      if (s.categoria) parts.push(`en ${catName(s.categoria)}`);
      if (s.marca.length) parts.push(`de ${s.marca.map(brandName).join(', ')}`);
      (empty.querySelector('[data-empty-wa]') as HTMLAnchorElement).href = whatsappLink(
        `${parts.join(' ')}. ¿Lo manejan?`,
      );
    };

    // 3) Estado inicial desde la URL (compatible con ?categoria= y ?marca= del inicio y el pie).
    const params = new URLSearchParams(location.search);
    const cat = params.getAll('categoria').find((c) => categories.some((x) => x.slug === c));
    if (cat) (form.querySelector(`[name="categoria"][value="${CSS.escape(cat)}"]`) as HTMLInputElement).checked = true;
    for (const m of params.getAll('marca')) {
      const box = form.querySelector<HTMLInputElement>(`[name="marca"][value="${CSS.escape(m)}"]`);
      if (box) box.checked = true;
    }
    q.value = (params.get('q') ?? '').slice(0, 80);

    // 4) Eventos
    form.addEventListener('input', (e) => apply(e.target === q ? 250 : 60));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      apply(0);
      q.blur(); // cierra el teclado en móvil para ver los resultados
    });
    form.addEventListener('reset', () => {
      setTimeout(() => {
        apply(0);
        q.focus();
      }, 0);
    });
    clearQ.addEventListener('click', () => {
      q.value = '';
      apply(0);
      q.focus();
    });
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && q.value) {
        e.preventDefault();
        q.value = '';
        apply(0);
      }
    });
    empty.querySelector('[data-clear]')!.addEventListener('click', () => form.reset());

    // 5) Estado pegado: sentinel + IntersectionObserver (nunca scroll + getBoundingClientRect).
    //    El margen inferior enorme hace que "no interseca" signifique solo "quedó por encima del header",
    //    aunque el sentinel esté bajo el pliegue o el scroll llegue de un salto.
    const headerH = getComputedStyle(document.documentElement).getPropertyValue('--header-h').trim() || '72px';
    const stuck = new IntersectionObserver(([e]) => form.classList.toggle('is-stuck', !e.isIntersecting), {
      rootMargin: `-${headerH} 0px 99999px 0px`,
      threshold: 0,
    });
    stuck.observe(sentinel);
    observers.push(stuck);

    // 6) Hoja de filtros (móvil)
    if (sheet && typeof sheet.showModal === 'function') {
      const sheetForm = sheet.querySelector('form')!;
      const applyBtn = sheet.querySelector<HTMLButtonElement>('[data-sheet-apply]')!;

      const readSheet = (): State => {
        const d = new FormData(sheetForm);
        return { categoria: String(d.get('categoria-m') ?? ''), marca: d.getAll('marca-m').map(String), q: q.value };
      };
      const setChecked = (root: HTMLElement, name: string, values: string[]) => {
        root.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((el) => {
          el.checked = values.includes(el.value);
        });
      };
      const syncToSheet = () => {
        const s = read();
        setChecked(sheetForm, 'categoria-m', [s.categoria]);
        setChecked(sheetForm, 'marca-m', s.marca);
      };
      const syncToBar = () => {
        const s = readSheet();
        setChecked(form, 'categoria', [s.categoria]);
        setChecked(form, 'marca', s.marca);
      };
      const updateApplyBtn = () => {
        const n = countFor(readSheet());
        applyBtn.textContent = n === 0 ? 'Sin resultados' : n === 1 ? 'Ver 1 producto' : `Ver ${n} productos`;
        applyBtn.disabled = n === 0;
        applyBtn.setAttribute('aria-disabled', String(n === 0));
      };

      openBtn.addEventListener('click', () => {
        syncToSheet();
        updateApplyBtn();
        sheet.returnValue = '';
        sheet.showModal();
        document.documentElement.style.overflow = 'hidden'; // respaldo de html:has(dialog[open])
        sheetForm.querySelector<HTMLInputElement>('[name="categoria-m"]:checked')?.focus();
      });
      sheetForm.addEventListener('input', updateApplyBtn);
      sheet.querySelector('[data-sheet-reset]')!.addEventListener('click', () => {
        setChecked(sheetForm, 'categoria-m', ['']);
        setChecked(sheetForm, 'marca-m', []);
        updateApplyBtn();
      });
      // Tocar el fondo (::backdrop) cierra sin aplicar.
      sheet.addEventListener('click', (e) => {
        if (e.target === sheet) sheet.close('');
      });
      sheet.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
        if (sheet.returnValue === 'apply') {
          syncToBar();
          apply(0);
          head.scrollIntoView({ block: 'start', behavior: reduceMotion() ? 'instant' : 'smooth' });
        }
        openBtn.focus();
      });
    }

    apply(0);
  }

  initCatalog();
  document.addEventListener('astro:page-load', initCatalog);
  document.addEventListener('astro:before-swap', () => {
    observers.forEach((o) => o.disconnect());
    observers = [];
  });
</script>

<style>
  /* Hero más bajo que el resto de interiores: aquí el visitante viene a trabajar. */
  .catalog-hero {
    min-height: clamp(200px, 22vw, 280px);
  }

  .catalog-hero p {
    margin-bottom: 0;
  }

  .catalog-section {
    padding-top: 0;
  }

  /* El ancla de scroll debe librar cabecera + barra pegada. */
  :global(html:has(.catalog-bar)) {
    scroll-padding-top: calc(var(--header-h) + 112px);
  }

  /* El fondo no hace scroll mientras la hoja está abierta (respaldo en JS). */
  :global(html:has(dialog.sheet[open])) {
    overflow: hidden;
  }

  #catalog-sentinel {
    height: 1px;
  }

  /* ---- Barra pegada ---- */
  .catalog-bar {
    margin: 0 0 var(--space-5);
    padding: 10px 0;
    border-left: 0;
    border-right: 0;
    border-top-color: transparent;
    border-bottom-color: transparent;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  /* Sin pegar es un bloque plano sobre la página; pegada muestra el material y su línea. */
  .catalog-bar:not(.is-stuck) {
    background: var(--color-bg);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
  }

  .catalog-bar.is-stuck {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-1);
  }

  .catalog-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px var(--space-4);
  }

  .catalog-bar__row {
    display: flex;
    flex: 1 1 420px;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  /* ---- Segmentado (radios nativos: un solo tab stop, flechas cambian la opción) ---- */
  .catalog-seg {
    margin: 0;
    border: 0;
    flex: 0 1 auto;
    min-inline-size: 0; /* un fieldset no encoge por debajo de min-content: aquí debe hacer scroll */
  }

  .seg__opt {
    position: relative;
    flex: none;
    display: inline-flex;
    scroll-snap-align: start;
  }

  .seg__opt input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .seg__opt .seg__btn {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    pointer-events: none;
  }

  .seg__opt:hover .seg__btn {
    color: var(--color-heading);
  }

  .seg__opt input:checked + .seg__btn {
    background: var(--color-surface-raised);
    color: var(--color-heading);
    box-shadow: var(--shadow-1);
  }

  .seg__opt input:focus-visible + .seg__btn {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .seg__opt:active .seg__btn {
    transform: scale(0.97);
    transition-duration: var(--dur-instant);
  }

  /* ---- Chips de marca (checkbox nativo) ---- */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .chip-opt {
    position: relative;
    display: inline-flex;
  }

  .chip-opt input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip-opt .chip {
    min-height: var(--control-h-sm);
    padding: 0 var(--space-4);
    animation: none;
    pointer-events: none;
    border-color: var(--color-border);
    background: var(--color-surface-raised);
  }

