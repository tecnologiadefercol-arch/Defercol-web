---
import { whatsappLink } from '../data/site';

interface Props {
  message?: string;
}

const { message } = Astro.props;
---

<!-- El flotante vive en su propio landmark (axe "region"): un aside complementario. -->
<aside class="wa-aside" aria-label="Cotizar por WhatsApp">
<a
  class="wa-float"
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener"
  aria-label="Cotizar por WhatsApp"
>
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
    ></path>
  </svg>
  <span>WhatsApp</span>
</a>
</aside>

<script>
  /**
   * La pastilla flotante cede cuando ya hay un acceso a WhatsApp en pantalla
   * (un .btn-whatsapp visible al menos a la mitad) y en /contacto, donde la
   * tarjeta de WhatsApp es el primer elemento. También cede ante la barra
   * inferior del detalle de producto (body.has-buybar, la pone esa página).
   * Idempotente: el nodo se vuelve a crear en cada navegación y se marca.
   */
  // Tras el primer scroll el círculo se encoge a 48 px (html[data-scrolled]) para tapar menos
  // contenido en móvil. El atributo se vuelve a poner en cada página (el ClientRouter lo borra).
  let scrollBound = false;
  function watchScroll() {
    const html = document.documentElement;
    const update = () => html.toggleAttribute('data-scrolled', (window.scrollY || window.pageYOffset) > 40);
    update();
    if (scrollBound) return;
    scrollBound = true;
    window.addEventListener('scroll', update, { passive: true });
  }

  function initWaFloat() {
    watchScroll();
    const el = document.querySelector<HTMLElement>('.wa-float');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';

    const path = location.pathname.replace(/\/$/, '') || '/';
    if (path === '/contacto') {
      el.classList.add('is-yielding');
      return;
    }

    const targets = Array.from(document.querySelectorAll<HTMLElement>('.btn-whatsapp'));
    if (!targets.length || !('IntersectionObserver' in window)) return;
    const visible = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
        el.classList.toggle('is-yielding', visible.size > 0);
      },
      { threshold: 0.5 },
    );
    targets.forEach((t) => io.observe(t));
  }

  initWaFloat();
  document.addEventListener('astro:page-load', initWaFloat);
</script>

<style>
  /* El aside es la caja fija (un landmark con display:contents pierde su rol en algunos navegadores). */
  .wa-aside {
    position: fixed;
    right: calc(var(--space-4) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-float);
    display: flex;
  }

  .wa-float {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h-lg);
    padding: 0 var(--space-5) 0 var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-whatsapp);
    color: var(--color-on-whatsapp);
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    text-decoration: none;
    box-shadow: var(--shadow-3), var(--shadow-whatsapp);
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out-expo);
  }

  .wa-float:hover {
    background: var(--color-whatsapp-hover);
  }

  .wa-float:active {
    transform: scale(0.97);
    transition-duration: var(--dur-instant);
  }

  .wa-float svg {
    flex: none;
  }

  /* Cede: ya hay otro acceso a WhatsApp en pantalla o una barra inferior. */
  .wa-float.is-yielding,
  :global(body.has-buybar) .wa-float {
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
  }

  @media (max-width: 600px) {
    .wa-float span {
      display: none;
    }

    .wa-float {
      width: 56px;
      height: 56px;
      padding: 0;
      justify-content: center;
      transition:
        background-color var(--dur-fast) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out),
        transform var(--dur-base) var(--ease-out-expo),
        width var(--dur-base) var(--ease-out-expo),
        height var(--dur-base) var(--ease-out-expo);
    }

    /* Ya leyendo: más pequeño, tapa menos (sigue ≥ 44 px). */
    :global(html[data-scrolled]) .wa-float {
      width: 48px;
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      transition: none;
    }

    .wa-float:active {
      transform: none;
    }
  }
</style>
