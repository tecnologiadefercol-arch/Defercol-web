---
/**
 * Tarjeta de producto. Se usa en el catálogo (/productos), en los relacionados
 * del detalle y dentro del recorrido del inicio (CatalogFilm, que la pinta
 * sobre cristal con sus propias reglas :global(.product-card*)).
 *
 * - `index`: posición en la lista. Las 6 primeras cargan la imagen con
 *   `eager` (están sobre el pliegue en escritorio) y fijan `--i` para el
 *   revelado escalonado (`.reveal` global).
 * - `fit`: fuerza el ajuste de la foto para toda la lista. Si se omite, se usa
 *   `imageFit` del producto: `cover` (fotos a sangre, ciclorama 4:3) o
 *   `contain` (recortes sobre fondo blanco/transparente).
 *
 * Un solo tab stop por tarjeta: el enlace del título cubre toda la tarjeta.
 */
import type { CollectionEntry } from 'astro:content';
import { brandBySlug, categoryBySlug, subcategoryBySlug } from '../data/site';

interface Props {
  product: CollectionEntry<'products'>;
  index?: number;
  fit?: 'cover' | 'contain';
}

const { product, index, fit: fitProp } = Astro.props;
const { title, brand, category, subcategory, summary, image, tags, sku, specs, imageFit } = product.data;
// La página puede forzar el ajuste; si no, manda el del producto (frontmatter `imageFit`).
const fit = fitProp ?? imageFit;
const brandName = brandBySlug(brand)?.name ?? brand;
const categoryInfo = categoryBySlug(category);
const categoryName = categoryInfo?.name ?? category;
const subName = subcategoryBySlug(category, subcategory)?.name ?? '';
// Pie en una línea: la subcategoría dice más que la categoría (que ya filtra el segmentado).
const footLabel = subName || (categoryInfo?.shortName ?? categoryName);
const href = `/productos/${product.id}`;

/** Misma normalización que el buscador del catálogo: minúsculas, sin tildes, espacios colapsados. */
const norm = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

// Incluye los valores de la ficha (medidas, materiales, normas): "bola 1/2" encuentra la 40G.
const search = norm(
  [title, sku ?? '', brandName, categoryName, subName, summary, ...tags, ...specs.map((s) => s.value)].join(' '),
);
const eager = typeof index === 'number' && index < 6;
---

<article
  class="card card--interactive reveal product-card"
  data-product
  data-brand={brand}
  data-category={category}
  data-subcategory={subcategory}
  data-search={search}
  data-fit={fit}
  style={typeof index === 'number' ? `--i: ${Math.min(index, 6)}` : undefined}
>
  <a href={href} class="product-card__media" tabindex="-1" aria-hidden="true">
    <img
      src={image ?? '/images/productos/placeholder.svg'}
      alt=""
      width="800"
      height="600"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="product-card__body">
    <div class="product-card__meta">
      <span class="badge">{brandName}</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    {sku && <span class="product-card__sku">Ref. <span class="mono">{sku}</span></span>}
    <p>{summary}</p>
    <div class="product-card__foot">
      <span class="product-card__cat">{footLabel}</span>
      <span class="product-card__more link link-chevron" aria-hidden="true">Ver producto</span>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    /* Sin transform en reposo: el enlace absoluto del título debe cubrir la tarjeta entera. */
    will-change: auto;
  }

  /* El filtro del catálogo oculta tarjetas y listas con [hidden]; que ningún display lo venza. */
  .product-card[hidden] {
    display: none;
  }

  /* Anillo de foco en toda la tarjeta (un solo tab stop: el enlace del título). */
  .product-card:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .product-card h3 a:focus-visible {
    outline: none;
  }

  .product-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-surface-2);
  }

  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  /* Recortes sobre fondo blanco: el marco también en blanco para que la foto no flote en un cuadro. */
  .product-card[data-fit='contain'] .product-card__media {
    background: #fff;
  }

  .product-card[data-fit='contain'] .product-card__media img {
    object-fit: contain;
    padding: 8%;
  }

  @media (hover: hover) {
    .product-card:hover .product-card__media img {
      transform: scale(1.03);
    }
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--card-pad-compact) var(--card-pad-compact) var(--space-4);
    flex: 1;
  }

  .product-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
  }

  .product-card__sku {
    margin-top: -2px;
    font-size: var(--text-xs);
    color: var(--color-text-2); /* 6,4:1 sobre blanco; text-3 se quedaba en 3,7:1 */
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }

  .product-card h3 {
    font-size: 1.05rem;
    line-height: 1.25;
    margin: var(--space-1) 0 0;
    text-wrap: balance;
  }

  .product-card h3 a {
    color: var(--color-heading);
    text-decoration: none;
  }

  /* El enlace del título se expande sobre toda la tarjeta. */
  .product-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .product-card p {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto; /* empuja el pie abajo sin estirar el resumen (el clamp de 2 líneas se respeta) */
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    /* Sobre el cristal oscuro del inicio la tarjeta es blanca: la línea sigue a currentColor. */
    border-top-color: color-mix(in srgb, currentColor 16%, transparent);
  }

  .product-card__cat {
    font-size: var(--text-xs);
    color: var(--color-text-2);
    line-height: 1.3;
  }

  .product-card__more {
    flex: none;
    font-size: var(--text-sm);
    color: inherit;
    gap: 2px;
  }

  .product-card__more:hover {
    text-decoration: none;
  }

  @media (hover: hover) {
    .product-card:hover .product-card__more::after {
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__media img {
      transition: none;
    }

    .product-card:hover .product-card__media img {
      transform: none;
    }
  }
</style>
